<Page
    x:Class="Nagi.WinUI.Pages.NowPlayingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:ImageEx"
    xmlns:models="using:Nagi.Core.Models"
    xmlns:core="using:Nagi.Core.Models.Lyrics"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="24" Padding="24,16,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="180" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="240" MinWidth="180" />
            </Grid.ColumnDefinitions>

            <!-- ─── Left column: Album art + track info ─── -->
            <StackPanel Grid.Column="0" Spacing="12" VerticalAlignment="Center">
                <controls:ImageEx x:Name="AlbumArtImage"
                                  Source="{x:Bind ViewModel.PlayerViewModel.AlbumArtUri, Mode=OneWay}"
                                  Width="220" Height="220"
                                  CornerRadius="8"
                                  Stretch="UniformToFill"
                                  IsCacheEnabled="True"
                                  DecodePixelWidth="440"
                                  Visibility="{x:Bind ViewModel.LyricsViewModel.ShowNoLyricsMessage, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

                <TextBlock x:Name="TrackTitleText"
                           Text="{x:Bind ViewModel.PlayerViewModel.SongTitle, Mode=OneWay}"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="2"
                           TextWrapping="WrapWholeWords" />

                <TextBlock Text="{x:Bind ViewModel.PlayerViewModel.ArtistName, Mode=OneWay}"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1" />
            </StackPanel>

            <!-- ─── Center column: Lyrics ─── -->
            <Grid Grid.Column="1">
                <!-- No lyrics: large album art fills the empty center space -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="16"
                            Visibility="{x:Bind ViewModel.LyricsViewModel.ShowNoLyricsMessage, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <controls:ImageEx Source="{x:Bind ViewModel.PlayerViewModel.AlbumArtUri, Mode=OneWay}"
                                      Width="360" Height="360"
                                      CornerRadius="12"
                                      Stretch="UniformToFill"
                                      IsCacheEnabled="True"
                                      DecodePixelWidth="720" />
                    <TextBlock Text="No lyrics available"
                               HorizontalAlignment="Center"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Timed lyrics scroll -->
                <ScrollViewer x:Name="LyricsScrollViewer"
                              Visibility="{x:Bind ViewModel.LyricsViewModel.ShowTimedLyrics, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="LyricsPanel" Spacing="8" Padding="0,120,0,120">
                        <ItemsRepeater x:Name="LyricsRepeater"
                                       ItemsSource="{x:Bind ViewModel.LyricsViewModel.LyricLines, Mode=OneWay}"
                                       ElementPrepared="LyricsRepeater_ElementPrepared"
                                       ElementClearing="LyricsRepeater_ElementClearing">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="core:LyricLine">
                                    <Grid Padding="8,4" Background="Transparent"
                                          Tag="{x:Bind}"
                                          PointerEntered="LyricItem_PointerEntered"
                                          PointerExited="LyricItem_PointerExited"
                                          Tapped="LyricItem_Tapped">
                                        <TextBlock Text="{x:Bind Text}"
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource BodyLargeTextBlockStyle}"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center" />
                                        <TextBlock Text="{x:Bind Text}"
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource BodyLargeTextBlockStyle}"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   Foreground="{StaticResource AppPrimaryColorBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ─── Right column: Up Next queue ─── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Up Next"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Margin="0,0,0,8" />
                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.QueueItems, Mode=OneWay}"
                          SelectionMode="Single"
                          ItemClick="QueueItem_ItemClick"
                          IsItemClickEnabled="True">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="4,4" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Song">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:ImageEx Grid.Column="0"
                                                  Source="{x:Bind AlbumArtUriFromTrack}"
                                                  Width="32" Height="32"
                                                  CornerRadius="4"
                                                  Stretch="UniformToFill"
                                                  IsCacheEnabled="True"
                                                  DecodePixelWidth="64" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}"
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1" />
                                    <TextBlock Text="{x:Bind ArtistName}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Page>
